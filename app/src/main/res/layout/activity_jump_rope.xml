<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include layout="@layout/common_title_layout"/>

    <!-- 1. Ready State Overlay -->
    <FrameLayout
        android:id="@+id/layoutReady"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF"
        android:visibility="visible">

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_orange"
            android:gravity="center"
            android:text="开始"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:bl_corners_radius="60dp"
            app:bl_solid_color="#FF7049" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="150dp"
            android:text="准备好跳绳了吗？"
            android:textColor="#333333"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- 2. Active Data Overlay (Running & Paused) -->
    <LinearLayout
        android:id="@+id/layoutData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#333333"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="消耗: 0.0 kcal"
            android:textColor="#66333333"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- 3. Control Buttons Overlay -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Pause / Resume Button -->
        <TextView
            android:id="@+id/btnPauseResume"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="暂停"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:bl_corners_radius="40dp"
            app:bl_solid_color="#F5F5F5" />

        <!-- Stop / Finish Button -->
        <TextView
            android:id="@+id/btnStop"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="完成"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:bl_corners_radius="40dp"
            app:bl_solid_color="#FF7049" />
            
    </LinearLayout>

</FrameLayout>