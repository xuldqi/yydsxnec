<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.dn.sports">

    <uses-sdk tools:overrideLibrary="com.luck.picture.lib" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- 已移除后台定位权限 (隐私合规整改) -->
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>

    <uses-feature android:name="android.hardware.sensor.stepcounter"/>
    <uses-feature android:name="feature:android.hardware.sensor.stepdetector"/>

    <application
        android:name=".StepApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_app"
        android:directBootAware="true"
        android:label="@string/app_name"
        tools:replace="android:label"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        >

        <meta-data android:name="app_name" android:value="微刻运动" />

        <meta-data
            android:name="com.dn.sports.utils.YGlideModule"
            android:value="AppGlideModule" />

        <activity android:name=".StartLogoActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SignActivity" android:screenOrientation="portrait" android:launchMode="singleTask"/>
        <activity android:name=".LuckRewardActivity" android:screenOrientation="portrait" android:launchMode="singleTask"/>
        <activity android:name=".MyMoneyActivity" android:screenOrientation="portrait" android:launchMode="singleTask"/>
        <activity android:name=".ShareFirendActivity" android:screenOrientation="portrait" android:launchMode="singleTask"/>
        <activity android:name=".UserInfoActivity" android:screenOrientation="portrait" android:launchMode="singleTask"/>
        <activity android:name=".YSXYActivity" android:screenOrientation="portrait"/>
        <activity android:name="com.dn.sports.activity.SettingActivity" android:screenOrientation="portrait"/>
        <activity android:name="com.dn.sports.activity.ShareAppActivity" android:screenOrientation="portrait"/>
        <activity android:name="com.dn.sports.activity.PrivacyInfoListActivity" android:screenOrientation="portrait"/>
        <activity android:name="com.dn.sports.activity.SdkShareListActivity" android:screenOrientation="portrait"/>

        <activity android:name=".AdActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:screenOrientation="portrait"/>
        <activity android:name=".WriteInviteCodeActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:screenOrientation="portrait"/>
        <activity android:name=".TaskAdActivity" android:screenOrientation="portrait"/>
        <activity android:name=".CountTimeActivity" android:launchMode="singleTask" android:screenOrientation="portrait"/>
        <activity android:name=".TargetActivity" android:launchMode="singleTask" android:screenOrientation="portrait"/>
        <activity android:name=".CountStepsActivity" android:launchMode="singleTask" android:screenOrientation="portrait"/>
        <activity android:name=".CoinRecordActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name=".target.StepCountTargetActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name=".CommonProblemActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name=".BodyRecordActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name=".BodyRecordInfoActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name=".CustomTargetActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name="com.dn.sports.activity.SetSportTargetActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name="com.dn.sports.jumprope.JumpRopeGuildActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name="com.dn.sports.jumprope.JumpRopeActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>
        <activity android:name="com.dn.sports.activity.SportRecordActivity" android:launchMode="singleTop" android:screenOrientation="fullUser"/>

        <activity android:name=".activity.ChangeOrderActivity" android:screenOrientation="fullUser"/>
        <activity android:name=".activity.ChartActivity" android:screenOrientation="fullUser"/>
        <activity android:name=".MustLoginActivity" android:launchMode="singleTop" android:screenOrientation="fullSensor"/>

        <!-- Home Screen Widget -->
        <receiver
            android:name=".widget.SportAppWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dn.sports.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service android:name=".StepServices"
            android:priority="1000"
            android:exported="false"
            android:enabled="true"/>
        <service android:name=".target.CountTimeServices"/>

        <activity android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:taskAffinity="com.dn.sports"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.dn.sports.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <provider
            android:name="com.bytedance.sdk.openadsdk.TTFileProvider"
            android:authorities="com.dn.sports.TTFileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="com.bytedance.sdk.openadsdk.multipro.TTMultiProvider"
            android:authorities="com.dn.sports.TTMultiProvider"
            android:exported="false" />

        <meta-data android:name="design_width_in_dp" android:value="375"/>

    </application>
</manifest>
